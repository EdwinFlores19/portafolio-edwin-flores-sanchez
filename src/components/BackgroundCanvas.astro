---
// BackgroundCanvas.astro - Futuristic Interactive Constellation & Neural Mesh Canvas
---

<div class="fixed inset-0 pointer-events-none z-0 overflow-hidden" aria-hidden="true">
  <!-- Interactive Canvas -->
  <canvas id="neural-canvas" class="w-full h-full block"></canvas>
  
  <!-- Ambient Atmospheric Vignette / Glow Orbs -->
  <div class="absolute -top-40 -left-40 w-96 h-96 bg-cyan-500/10 rounded-full blur-[140px] pointer-events-none"></div>
  <div class="absolute top-1/3 -right-40 w-[450px] h-[450px] bg-purple-600/10 rounded-full blur-[160px] pointer-events-none"></div>
  <div class="absolute -bottom-20 left-1/3 w-[500px] h-[500px] bg-blue-600/10 rounded-full blur-[180px] pointer-events-none"></div>
</div>

<script>
  function initNeuralCanvas() {
    const canvas = document.getElementById('neural-canvas') as HTMLCanvasElement;
    if (!canvas) return;

    const ctx = canvas.getContext('2d', { alpha: true });
    if (!ctx) return;

    let width = 0;
    let height = 0;
    let dpr = window.devicePixelRatio || 1;
    let animationFrameId: number;

    const mouse = {
      x: -1000,
      y: -1000,
      radius: 140,
      active: false
    };

    function resize() {
      if (!canvas || !ctx) return;
      width = window.innerWidth;
      height = window.innerHeight;
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      canvas.width = width * dpr;
      canvas.height = height * dpr;
      ctx.scale(dpr, dpr);
      canvas.style.width = `${width}px`;
      canvas.style.height = `${height}px`;
      mouse.radius = Math.max(120, Math.min(width, height) / 7);
      initParticles();
    }

    interface Particle {
      x: number;
      y: number;
      vx: number;
      vy: number;
      baseRadius: number;
      color: string;
      glowColor: string;
      isAccent: boolean;
      pulsePhase: number;
    }

    interface Packet {
      fromIdx: number;
      toIdx: number;
      progress: number;
      speed: number;
      color: string;
    }

    let particles: Particle[] = [];
    let packets: Packet[] = [];

    const colors = [
      { fill: '#00f3ff', glow: 'rgba(0, 243, 255, 0.8)' }, // Neon Cyan
      { fill: '#38bdf8', glow: 'rgba(56, 189, 248, 0.8)' }, // Sky
      { fill: '#bc13fe', glow: 'rgba(188, 19, 254, 0.8)' }, // Neon Purple
      { fill: '#F0AB00', glow: 'rgba(240, 171, 0, 0.8)' }   // SAP Gold
    ];

    function initParticles() {
      particles = [];
      packets = [];
      const densityDivider = width < 768 ? 16000 : 10000;
      const count = Math.min(Math.floor((width * height) / densityDivider), 110);

      for (let i = 0; i < count; i++) {
        const colorObj = Math.random() < 0.65 ? colors[0] : (Math.random() < 0.85 ? colors[2] : colors[3]);
        const isAccent = colorObj.fill === '#F0AB00' || colorObj.fill === '#bc13fe';

        particles.push({
          x: Math.random() * width,
          y: Math.random() * height,
          vx: (Math.random() - 0.5) * 0.75,
          vy: (Math.random() - 0.5) * 0.75,
          baseRadius: Math.random() * 2 + (isAccent ? 1.8 : 1.2),
          color: colorObj.fill,
          glowColor: colorObj.glow,
          isAccent,
          pulsePhase: Math.random() * Math.PI * 2
        });
      }
    }

    // Window event listeners
    window.addEventListener('resize', resize);
    window.addEventListener('mousemove', (e) => {
      mouse.x = e.clientX;
      mouse.y = e.clientY;
      mouse.active = true;
    });

    window.addEventListener('mouseleave', () => {
      mouse.active = false;
      mouse.x = -1000;
      mouse.y = -1000;
    });

    // Spawn packets along active lines periodically
    function maybeSpawnPacket(i: number, j: number) {
      if (packets.length > 12) return;
      if (Math.random() < 0.003) {
        packets.push({
          fromIdx: i,
          toIdx: j,
          progress: 0,
          speed: 0.015 + Math.random() * 0.02,
          color: Math.random() < 0.5 ? '#00f3ff' : '#F0AB00'
        });
      }
    }

    let isVisible = true;
    document.addEventListener('visibilitychange', () => {
      isVisible = !document.hidden;
      if (isVisible) {
        animate();
      }
    });

    function animate() {
      if (!isVisible) return;
      if (!ctx) return;

      ctx.clearRect(0, 0, width, height);

      const maxDist = width < 768 ? 100 : 135;
      const maxDistSq = maxDist * maxDist;

      // Update and draw connections
      for (let i = 0; i < particles.length; i++) {
        const p1 = particles[i];

        // Movement
        p1.x += p1.vx;
        p1.y += p1.vy;

        // Bounce from walls
        if (p1.x < 0 || p1.x > width) p1.vx *= -1;
        if (p1.y < 0 || p1.y > height) p1.vy *= -1;

        // Mouse interaction
        if (mouse.active) {
          const dx = mouse.x - p1.x;
          const dy = mouse.y - p1.y;
          const dist = Math.sqrt(dx * dx + dy * dy);
          if (dist < mouse.radius) {
            const force = (mouse.radius - dist) / mouse.radius;
            const angle = Math.atan2(dy, dx);
            p1.x -= Math.cos(angle) * force * 3;
            p1.y -= Math.sin(angle) * force * 3;
          }
        }

        // Draw connections with next particles
        for (let j = i + 1; j < particles.length; j++) {
          const p2 = particles[j];
          const dx = p1.x - p2.x;
          const dy = p1.y - p2.y;
          const distSq = dx * dx + dy * dy;

          if (distSq < maxDistSq) {
            const dist = Math.sqrt(distSq);
            const alpha = (1 - dist / maxDist) * 0.45;
            
            ctx.beginPath();
            ctx.moveTo(p1.x, p1.y);
            ctx.lineTo(p2.x, p2.y);
            
            if (p1.isAccent || p2.isAccent) {
              ctx.strokeStyle = `rgba(188, 19, 254, ${alpha * 0.9})`;
            } else {
              ctx.strokeStyle = `rgba(0, 243, 255, ${alpha})`;
            }
            ctx.lineWidth = 0.8;
            ctx.stroke();

            maybeSpawnPacket(i, j);
          }
        }

        // Pulse particles
        p1.pulsePhase += 0.03;
        const radius = p1.baseRadius + Math.sin(p1.pulsePhase) * 0.5;

        // Draw Particle Node
        ctx.beginPath();
        ctx.arc(p1.x, p1.y, Math.max(radius, 0.8), 0, Math.PI * 2);
        ctx.fillStyle = p1.color;
        ctx.shadowBlur = p1.isAccent ? 12 : 8;
        ctx.shadowColor = p1.glowColor;
        ctx.fill();
        ctx.shadowBlur = 0; // reset
      }

      // Render and update data packets
      for (let k = packets.length - 1; k >= 0; k--) {
        const pkt = packets[k];
        pkt.progress += pkt.speed;

        if (pkt.progress >= 1) {
          packets.splice(k, 1);
          continue;
        }

        const pFrom = particles[pkt.fromIdx];
        const pTo = particles[pkt.toIdx];
        if (!pFrom || !pTo) {
          packets.splice(k, 1);
          continue;
        }

        const curX = pFrom.x + (pTo.x - pFrom.x) * pkt.progress;
        const curY = pFrom.y + (pTo.y - pFrom.y) * pkt.progress;

        ctx.beginPath();
        ctx.arc(curX, curY, 2.5, 0, Math.PI * 2);
        ctx.fillStyle = pkt.color;
        ctx.shadowBlur = 10;
        ctx.shadowColor = pkt.color;
        ctx.fill();
        ctx.shadowBlur = 0;
      }

      animationFrameId = requestAnimationFrame(animate);
    }

    resize();
    animate();
  }

  // Run on page load and view transitions
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initNeuralCanvas);
  } else {
    initNeuralCanvas();
  }
</script>
