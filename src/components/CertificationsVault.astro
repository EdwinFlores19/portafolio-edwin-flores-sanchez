---
// CertificationsVault.astro - Verified Credentials & Official SAP/AI Badges
import { certifications } from '../data/certifications';
---

<section id="certifications" class="py-20 px-4 sm:px-6 lg:px-8 relative z-10 overflow-hidden">
  <div class="max-w-7xl mx-auto space-y-12">
    
    <!-- Section Header -->
    <div class="text-center space-y-4 max-w-3xl mx-auto">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full glass-panel border border-cyan-500/40 text-cyan-300 text-xs font-mono tracking-widest uppercase shadow-neon-cyan/20">
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
        <span>Acreditaciones Oficiales</span>
      </div>
      <h2 class="text-3xl sm:text-4xl md:text-5xl font-black font-display text-white tracking-tight">
        Bóveda de <span class="text-transparent bg-clip-text bg-gradient-to-r from-emerald-400 via-cyan-300 to-purple-400">Certificaciones</span>
      </h2>
      <p class="text-sm sm:text-base text-slate-200 leading-relaxed font-normal">
        Certificaciones y cursos oficiales de SAP Learning, Google Cloud Skills, especializaciones en Anthropic Claude y distinciones académicas de la USIL.
      </p>
    </div>

    <!-- Badges Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-5 sm:gap-6">
      {certifications.map(cert => (
        <div class="glass-panel glass-panel-hover rounded-3xl p-5 sm:p-6 lg:p-7 border border-white/10 hover:border-cyan-400/50 transition-all duration-300 flex flex-col justify-between group space-y-5">
          
          <div class="space-y-4">
            <!-- Header Row: Issuer Badge & Date -->
            <div class="flex items-center justify-between">
              <span class={`px-3.5 py-1.5 rounded-full text-xs font-mono font-black uppercase tracking-wider ${
                cert.issuer === 'SAP' ? 'bg-amber-500/25 text-amber-300 border border-amber-400/50' :
                cert.issuer === 'Anthropic' ? 'bg-orange-500/25 text-orange-300 border border-orange-400/50' :
                cert.issuer === 'Google' ? 'bg-blue-500/25 text-blue-300 border border-blue-400/50' :
                'bg-cyan-500/25 text-cyan-300 border border-cyan-400/50'
              }`}>
                {cert.issuer} • {cert.category}
              </span>
              <span class="text-xs font-mono text-slate-300 font-semibold">{cert.issueDate}</span>
            </div>

            <!-- Title -->
            <h3 class="text-xl font-black text-white font-display group-hover:text-cyan-300 transition-colors leading-snug">
              {cert.title}
            </h3>

            <!-- Description -->
            <p class="text-sm text-slate-200 leading-relaxed font-normal">
              {cert.description}
            </p>

            <!-- Skills chips -->
            <div class="flex flex-wrap gap-1.5 pt-2">
              {cert.skillsAcquired.map(skill => (
                <span class="text-xs font-mono px-2.5 py-1 rounded-md bg-white/5 text-slate-200 border border-white/10 font-medium">
                  {skill}
                </span>
              ))}
            </div>
          </div>

          <!-- Bottom: Badge Code & Official Link -->
          <div class="pt-4 border-t border-white/10 flex items-center justify-between font-mono text-xs sm:text-sm">
            {cert.badgeCode && (
              <span class="text-xs text-slate-300">
                ID: <span class="text-cyan-400 font-bold">{cert.badgeCode}</span>
              </span>
            )}
            {cert.credentialUrl ? (
              <a
                href={cert.credentialUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1.5 text-cyan-400 hover:text-white font-bold transition-colors ml-auto"
              >
                <span>Verificar Oficial</span>
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6M15 3h6v6M10 14 21 3"/></svg>
              </a>
            ) : (
              <span class="text-xs text-emerald-400 ml-auto flex items-center gap-1 font-bold">
                <span>✓</span> Acreditado
              </span>
            )}
          </div>

        </div>
      ))}
    </div>

  </div>
</section>
