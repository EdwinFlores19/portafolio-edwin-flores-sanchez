---
// Footer.astro - Futuristic Terminal Footer & System Status
import { profile } from '../data/profile';
---

<footer class="border-t border-white/10 bg-slate-950/80 backdrop-blur-xl relative z-10 py-12 px-4 sm:px-6 lg:px-8 font-mono text-xs text-slate-400">
  <div class="max-w-7xl mx-auto space-y-8">
    
    <div class="flex flex-col md:flex-row items-center justify-between gap-6 pb-8 border-b border-white/5">
      
      <!-- Brand & Status -->
      <div class="space-y-2 text-center md:text-left">
        <div class="flex items-center justify-center md:justify-start gap-2.5">
          <div class="w-8 h-8 rounded-xl bg-cyan-500/20 border border-cyan-400/40 flex items-center justify-center font-bold text-cyan-300">
            E
          </div>
          <span class="font-extrabold text-white text-base font-display">EDWIN FLORES SANCHEZ</span>
        </div>
        <p class="text-[11px] text-slate-400 max-w-md">
          Consultor Funcional SAP S/4HANA & Ingeniero de Sistemas de Información. Especialista en MM, PS, FICO y Agentes Autónomos con IA.
        </p>
      </div>

      <!-- Live Telemetry Box -->
      <div class="glass-panel rounded-2xl p-3 border border-white/10 flex items-center gap-4 text-[10px]">
        <div class="flex items-center gap-1.5">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-ping"></span>
          <span class="text-emerald-400 font-bold">SYSTEM ONLINE</span>
        </div>
        <span class="text-slate-600">|</span>
        <span class="text-slate-300">LATAM / LIMA (UTC-5)</span>
        <span class="text-slate-600">|</span>
        <span class="text-cyan-400">ASTRO 5 SSG</span>
      </div>

      <!-- Quick Back to Top -->
      <div>
        <a
          href="#home"
          class="p-2.5 rounded-xl glass-panel border border-white/10 hover:border-cyan-400 text-slate-300 hover:text-cyan-300 transition-all flex items-center gap-1.5"
          title="Volver al inicio"
        >
          <span>↑ Subir</span>
        </a>
      </div>

    </div>

    <!-- Bottom Credits & Social -->
    <div class="flex flex-col sm:flex-row items-center justify-between gap-4 text-[11px] text-slate-400">
      <div>
        © 2026 Edwin Flores Sanchez. Diseñado con arquitectura de vanguardia y construido con Astro, TypeScript & Tailwind CSS.
      </div>

      <div class="flex items-center gap-4">
        <a href={profile.linkedin} target="_blank" rel="noopener noreferrer" class="hover:text-cyan-400 transition-colors">LinkedIn</a>
        <a href={profile.github} target="_blank" rel="noopener noreferrer" class="hover:text-cyan-400 transition-colors">GitHub</a>
        <a href={profile.whatsappLink} target="_blank" rel="noopener noreferrer" class="hover:text-cyan-400 transition-colors">WhatsApp</a>
        <a href={`mailto:${profile.email}`} class="hover:text-cyan-400 transition-colors">Email</a>
      </div>
    </div>

  </div>
</footer>
