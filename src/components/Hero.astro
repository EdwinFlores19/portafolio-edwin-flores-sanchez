---
// Hero.astro - Ultra-futuristic Hero Section with Real Profile Photo & 3D Holographic Badges
import { profile } from '../data/profile';
---

<section id="home" class="relative min-h-[92vh] flex items-center justify-center pt-28 pb-16 px-4 sm:px-6 lg:px-8 overflow-hidden">
  
  <div class="max-w-7xl mx-auto w-full grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center relative z-10">
    
    <!-- Left Column: Headlines & Pitch -->
    <div class="lg:col-span-7 space-y-6 text-center lg:text-left">
      
      <!-- Status Badge Pill -->
      <div class="inline-flex items-center gap-2.5 px-4 py-1.5 rounded-full glass-panel border border-cyan-400/40 text-cyan-300 text-xs font-mono tracking-wide shadow-neon-cyan/20 animate-float-slow">
        <span class="relative flex h-2.5 w-2.5">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-emerald-500"></span>
        </span>
        <span class="font-bold">System Engineer & SAP S/4HANA Consultant</span>
        <span class="hidden sm:inline text-cyan-500">|</span>
        <span class="hidden sm:inline text-slate-300">AI Agents & Clean Core</span>
      </div>

      <!-- Main Headline -->
      <div class="space-y-1">
        <h1 class="text-5xl sm:text-6xl md:text-7xl lg:text-8xl font-black tracking-tighter uppercase font-display leading-[0.95]">
          <span class="block text-white">EDWIN</span>
          <span class="block text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 via-sky-300 to-purple-400 glow-cyan">
            FLORES
          </span>
        </h1>
        <p class="text-xl sm:text-2xl md:text-3xl font-bold font-display text-transparent bg-clip-text bg-gradient-to-r from-white via-cyan-100 to-cyan-400 pt-2 leading-snug">
          Construyendo el puente entre <span class="text-cyan-400 underline decoration-cyan-500/50 underline-offset-4">SAP Architecture</span> e <span class="text-purple-400 underline decoration-purple-500/50 underline-offset-4">Inteligencia Artificial</span>.
        </p>
      </div>

      <!-- Bio / Mission statement -->
      <p class="text-sm sm:text-base md:text-lg text-slate-300/90 max-w-2xl font-normal leading-relaxed mx-auto lg:mx-0">
        No solo escribo código; diseño <strong class="text-cyan-300 font-semibold">ecosistemas digitales</strong>. Desde migraciones selectivas S/4HANA Bluefield y arquitectura Clean Core hasta <strong class="text-purple-300 font-semibold">agentes inteligentes autónomos</strong> y pipelines de datos con reducción de hasta un 80% en tiempos operativos.
      </p>

      <!-- Key Metrics Row -->
      <div class="grid grid-cols-3 gap-3 sm:gap-4 py-2 max-w-lg mx-auto lg:mx-0 font-mono text-left">
        <div class="glass-panel rounded-2xl p-3 border-cyan-500/20">
          <span class="block text-xl sm:text-2xl font-black text-cyan-400">+20</span>
          <span class="block text-[10px] sm:text-xs text-slate-400 uppercase tracking-tight">Proyectos Corp.</span>
        </div>
        <div class="glass-panel rounded-2xl p-3 border-purple-500/20">
          <span class="block text-xl sm:text-2xl font-black text-purple-400">80%</span>
          <span class="block text-[10px] sm:text-xs text-slate-400 uppercase tracking-tight">Reducción IA</span>
        </div>
        <div class="glass-panel rounded-2xl p-3 border-amber-500/20">
          <span class="block text-xl sm:text-2xl font-black text-amber-400">1er Lugar</span>
          <span class="block text-[10px] sm:text-xs text-slate-400 uppercase tracking-tight">Capstone USIL</span>
        </div>
      </div>

      <!-- Action Buttons -->
      <div class="flex flex-wrap items-center justify-center lg:justify-start gap-3 pt-2">
        <a
          href="#projects"
          class="px-6 sm:px-8 py-3.5 rounded-2xl text-xs sm:text-sm font-black font-mono text-slate-950 bg-gradient-to-r from-cyan-400 via-sky-300 to-cyan-300 hover:from-cyan-300 hover:to-white shadow-neon-cyan transition-all duration-300 active:scale-95 hover:-translate-y-0.5 flex items-center gap-2 group"
        >
          <span>EXPLORAR PROYECTOS</span>
          <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
          </svg>
        </a>

        <a
          href="#bridge"
          class="px-5 sm:px-6 py-3.5 rounded-2xl text-xs sm:text-sm font-bold font-mono text-cyan-300 glass-panel border border-cyan-500/30 hover:border-cyan-400 hover:bg-cyan-950/40 hover:shadow-neon-cyan transition-all duration-300 active:scale-95 hover:-translate-y-0.5 flex items-center gap-2"
        >
          <svg class="w-4 h-4 text-purple-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="10"></circle>
            <path d="m4.93 4.93 4.24 4.24"></path>
            <path d="m14.83 9.17 4.24-4.24"></path>
            <path d="m14.83 14.83 4.24 4.24"></path>
            <path d="m9.17 14.83-4.24 4.24"></path>
          </svg>
          <span>EL PUENTE SAP & IA</span>
        </a>

        <a
          href={profile.whatsappLink}
          target="_blank"
          rel="noopener noreferrer"
          class="px-4 sm:px-5 py-3.5 rounded-2xl text-xs sm:text-sm font-bold font-mono text-emerald-300 bg-emerald-950/40 border border-emerald-500/40 hover:bg-emerald-900/60 hover:shadow-emerald-500/30 transition-all duration-300 active:scale-95 flex items-center gap-2"
          title="Hablar directamente por WhatsApp"
        >
          <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
            <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
          </svg>
          <span>WhatsApp</span>
        </a>
      </div>

    </div>

    <!-- Right Column: Profile Portal with 3D Hologram Tilt Effect -->
    <div class="lg:col-span-5 flex justify-center items-center relative">
      
      <!-- Rotating Holographic Orbit Rings -->
      <div class="absolute w-[340px] sm:w-[420px] md:w-[460px] h-[340px] sm:h-[420px] md:h-[460px] rounded-full border border-dashed border-cyan-500/20 animate-spin" style="animation-duration: 40s;"></div>
      <div class="absolute w-[360px] sm:w-[450px] md:w-[490px] h-[360px] sm:h-[450px] md:h-[490px] rounded-full border border-dotted border-purple-500/20 animate-spin" style="animation-duration: 60s; animation-direction: reverse;"></div>

      <!-- Main Portrait Container with Tilt -->
      <div id="hero-portrait-card" class="relative tilt-element group">
        
        <!-- Glowing Gradient Ring -->
        <div class="absolute -inset-2 sm:-inset-3 rounded-full bg-gradient-to-tr from-cyan-500 via-purple-600 to-amber-500 opacity-60 blur-xl group-hover:opacity-90 group-hover:blur-2xl transition-all duration-500 animate-pulse-glow"></div>

        <!-- Circular Mask & Image -->
        <div class="relative w-64 h-64 sm:w-80 sm:h-80 md:w-96 md:h-96 rounded-full p-2 bg-gradient-to-b from-cyan-400 via-slate-900 to-purple-600 shadow-2xl overflow-hidden border-2 border-cyan-400/80">
          <img
            src="/assets/perfil.jpg"
            alt="Edwin Flores Sanchez - Consultor SAP S/4HANA & Especialista en IA"
            class="w-full h-full object-cover object-center rounded-full scale-105 group-hover:scale-110 transition-transform duration-700 brightness-105 contrast-105"
            loading="eager"
          />
          <!-- Scanline overlay -->
          <div class="absolute inset-0 bg-gradient-to-b from-transparent via-cyan-500/5 to-transparent pointer-events-none animate-scanline"></div>
        </div>

        <!-- Floating Badge 1: USIL Tercio Superior (as in the photo) -->
        <div class="absolute -bottom-4 right-0 sm:right-2 glass-panel rounded-2xl p-3 border border-cyan-400/50 shadow-neon-cyan flex items-center gap-3 backdrop-blur-xl animate-float-slow" style="animation-delay: 1s;">
          <div class="w-9 h-9 rounded-xl bg-cyan-950/80 border border-cyan-400/60 flex items-center justify-center text-lg">
            🎓
          </div>
          <div>
            <span class="block text-[9px] font-mono font-bold text-cyan-400 uppercase tracking-widest">ESTATUS ACADÉMICO</span>
            <span class="block text-xs sm:text-sm font-black text-white font-display">Tercio Superior USIL</span>
          </div>
        </div>

        <!-- Floating Badge 2: 1er Lugar Capstone RIA (Top Left) -->
        <div class="absolute -top-3 -left-2 sm:-left-6 glass-panel rounded-2xl p-2.5 sm:p-3 border border-amber-400/50 shadow-neon-gold flex items-center gap-2.5 backdrop-blur-xl animate-float-slow">
          <div class="w-8 h-8 rounded-xl bg-amber-950/80 border border-amber-400/60 flex items-center justify-center text-base">
            🏆
          </div>
          <div>
            <span class="block text-[8px] font-mono font-bold text-amber-400 uppercase tracking-wider">CONCURSO CAPSTONE</span>
            <span class="block text-xs font-black text-white">1er Lugar USIL</span>
          </div>
        </div>

        <!-- Floating Badge 3: SEIDOR Consulting (Bottom Left) -->
        <div class="hidden sm:flex absolute top-1/2 -left-8 -translate-y-1/2 glass-panel rounded-xl px-3 py-2 border border-purple-500/40 shadow-neon-purple items-center gap-2 backdrop-blur-xl">
          <span class="w-2 h-2 rounded-full bg-purple-400 animate-ping"></span>
          <span class="text-[11px] font-mono font-bold text-purple-200">SEIDOR S/4HANA</span>
        </div>

      </div>

    </div>

  </div>

</section>

<script>
  // 3D Card Tilt Interaction on Desktop
  const card = document.getElementById('hero-portrait-card');
  if (card && window.innerWidth > 768) {
    const parent = card.parentElement;
    parent?.addEventListener('mousemove', (e) => {
      const rect = card.getBoundingClientRect();
      const x = e.clientX - rect.left;
      const y = e.clientY - rect.top;
      const centerX = rect.width / 2;
      const centerY = rect.height / 2;
      const rotateX = ((y - centerY) / centerY) * -12;
      const rotateY = ((x - centerX) / centerX) * 12;
      card.style.transform = `perspective(1000px) rotateX(${rotateX}deg) rotateY(${rotateY}deg) scale3d(1.03, 1.03, 1.03)`;
    });

    parent?.addEventListener('mouseleave', () => {
      card.style.transform = 'perspective(1000px) rotateX(0deg) rotateY(0deg) scale3d(1, 1, 1)';
    });
  }
</script>
