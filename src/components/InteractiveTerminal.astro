---
// InteractiveTerminal.astro - Futuristic EdwinOS v2.6.0 Hacker Terminal & HUD Console
import { terminalCommands } from '../data/terminalCommands';
---

<!-- Fixed Floating Toggle Button (Bottom-Right) -->
<div class="fixed bottom-4 right-4 sm:bottom-6 sm:right-6 z-40">
  <button
    id="terminal-floating-trigger"
    class="px-3.5 sm:px-4 py-2 sm:py-2.5 rounded-2xl glass-panel border border-cyan-400/50 text-cyan-300 font-mono text-xs font-bold shadow-neon-cyan/40 hover:bg-cyan-950/70 hover:scale-105 active:scale-95 transition-all duration-300 flex items-center gap-2 group backdrop-blur-2xl"
    title="Abrir Consola Terminal EdwinOS"
  >
    <span class="w-2 h-2 rounded-full bg-emerald-400 animate-ping"></span>
    <span class="text-cyan-400 font-black">>_</span>
    <span class="hidden sm:inline">EdwinOS v2.6.0</span>
    <span class="px-1.5 py-0.5 rounded bg-cyan-900/50 text-[10px] text-cyan-200 border border-cyan-700/40">CLI</span>
  </button>
</div>

<!-- Modal / Drawer Terminal Window -->
<div
  id="edwin-terminal-modal"
  class="fixed inset-0 z-50 flex items-center justify-center p-2 sm:p-6 bg-black/85 backdrop-blur-md hidden"
  aria-modal="true"
  role="dialog"
>
  <div class="glass-panel rounded-2xl sm:rounded-3xl border border-cyan-500/50 max-w-3xl w-full h-[90vh] sm:h-[540px] max-h-[92vh] flex flex-col shadow-2xl relative overflow-hidden bg-slate-950/95 font-mono">
    
    <!-- Top Bar: Window Controls & Title -->
    <div class="px-4 py-3 bg-slate-900/90 border-b border-white/10 flex items-center justify-between select-none">
      <div class="flex items-center gap-2">
        <span class="w-3 h-3 rounded-full bg-rose-500/80 cursor-pointer hover:opacity-100" id="term-close-btn" title="Cerrar"></span>
        <span class="w-3 h-3 rounded-full bg-amber-500/80 cursor-pointer" title="Minimizar"></span>
        <span class="w-3 h-3 rounded-full bg-emerald-500/80 cursor-pointer" title="Maximizar"></span>
        <span class="text-xs font-bold text-slate-300 ml-2 flex items-center gap-2">
          <span>edwin@s4hana-ai: ~</span>
          <span class="text-[10px] px-2 py-0.5 rounded bg-cyan-950 text-cyan-300 border border-cyan-800/40">EdwinOS Kernel 2.6.0</span>
        </span>
      </div>

      <div class="flex items-center gap-2 text-xs text-slate-400">
        <span class="hidden sm:inline text-[11px]">UTC-5</span>
        <button id="term-clear-btn" class="text-[11px] hover:text-cyan-400 px-2 py-0.5 rounded hover:bg-white/5 transition-colors">
          [clear]
        </button>
      </div>
    </div>

    <!-- Terminal Output Screen -->
    <div id="terminal-screen" class="flex-1 p-4 overflow-y-auto space-y-3 text-xs leading-relaxed text-slate-200">
      <div class="text-cyan-400 font-bold">
        ╔══════════════════════════════════════════════════════════════════╗<br/>
        ║   EDWIN JUNIOR FLORES SANCHEZ — TERMINAL INTERACTIVO v2.6.0      ║<br/>
        ║   SAP S/4HANA Enterprise Architect & Autonomous AI Specialist    ║<br/>
        ╚══════════════════════════════════════════════════════════════════╝
      </div>
      <p class="text-slate-400">
        Bienvenido al entorno interactivo de línea de comandos. Escribe <span class="text-cyan-300 font-bold">'help'</span> para ver los módulos disponibles o haz clic en los accesos rápidos a continuación:
      </p>

      <!-- History outputs container -->
      <div id="terminal-history" class="space-y-3"></div>
    </div>

    <!-- Quick Action Command Chips -->
    <div class="px-4 py-2 bg-slate-900/50 border-t border-white/5 flex flex-wrap items-center gap-1.5 overflow-x-auto text-[11px]">
      <span class="text-slate-400 text-[10px] uppercase mr-1">Comandos:</span>
      <button class="term-chip px-2.5 py-1 rounded-md bg-white/5 hover:bg-cyan-500/20 text-cyan-300 border border-white/10 hover:border-cyan-400/40 transition-all" data-cmd="whoami">whoami</button>
      <button class="term-chip px-2.5 py-1 rounded-md bg-white/5 hover:bg-cyan-500/20 text-cyan-300 border border-white/10 hover:border-cyan-400/40 transition-all" data-cmd="sap">sap</button>
      <button class="term-chip px-2.5 py-1 rounded-md bg-white/5 hover:bg-cyan-500/20 text-cyan-300 border border-white/10 hover:border-cyan-400/40 transition-all" data-cmd="ai">ai</button>
      <button class="term-chip px-2.5 py-1 rounded-md bg-white/5 hover:bg-cyan-500/20 text-cyan-300 border border-white/10 hover:border-cyan-400/40 transition-all" data-cmd="cleancore">cleancore</button>
      <button class="term-chip px-2.5 py-1 rounded-md bg-white/5 hover:bg-cyan-500/20 text-cyan-300 border border-white/10 hover:border-cyan-400/40 transition-all" data-cmd="projects">projects</button>
      <button class="term-chip px-2.5 py-1 rounded-md bg-white/5 hover:bg-cyan-500/20 text-cyan-300 border border-white/10 hover:border-cyan-400/40 transition-all" data-cmd="experience">experience</button>
      <button class="term-chip px-2.5 py-1 rounded-md bg-white/5 hover:bg-cyan-500/20 text-cyan-300 border border-white/10 hover:border-cyan-400/40 transition-all" data-cmd="hire">hire ⭐</button>
      <button class="term-chip px-2.5 py-1 rounded-md bg-amber-950/40 hover:bg-amber-900/60 text-amber-300 border border-amber-500/40 transition-all" data-cmd="joke">joke 😄</button>
      <button class="term-chip px-2.5 py-1 rounded-md bg-white/5 hover:bg-cyan-500/20 text-cyan-300 border border-white/10 hover:border-cyan-400/40 transition-all" data-cmd="coffee">coffee ☕</button>
      <button class="term-chip px-2.5 py-1 rounded-md bg-white/5 hover:bg-cyan-500/20 text-cyan-300 border border-white/10 hover:border-cyan-400/40 transition-all" data-cmd="contact">contact</button>
      <button class="term-chip px-2.5 py-1 rounded-md bg-emerald-950/40 hover:bg-emerald-900/60 text-emerald-300 border border-emerald-500/40 transition-all" data-cmd="matrix">matrix 🕶️</button>
    </div>

    <!-- Input Line -->
    <div class="p-3 bg-slate-950 border-t border-white/10 flex items-center gap-2">
      <span class="text-cyan-400 font-black">>_</span>
      <input
        type="text"
        id="terminal-input"
        placeholder="Escribe un comando ('help', 'sap', 'hire', etc.) y presiona Enter..."
        class="flex-1 bg-transparent text-white font-mono text-xs outline-none placeholder:text-slate-500 caret-cyan-400"
        autocomplete="off"
        spellcheck="false"
      />
      <button
        id="terminal-submit-btn"
        class="px-3 py-1 rounded-lg bg-cyan-400 text-slate-950 font-bold text-xs hover:bg-white transition-colors"
      >
        Ejecutar
      </button>
    </div>

  </div>
</div>

<script>
  import { terminalCommands } from '../data/terminalCommands';

  const modal = document.getElementById('edwin-terminal-modal');
  const floatingBtn = document.getElementById('terminal-floating-trigger');
  const closeBtn = document.getElementById('term-close-btn');
  const clearBtn = document.getElementById('term-clear-btn');
  const input = document.getElementById('terminal-input') as HTMLInputElement;
  const submitBtn = document.getElementById('terminal-submit-btn');
  const historyEl = document.getElementById('terminal-history');
  const screen = document.getElementById('terminal-screen');
  const chips = document.querySelectorAll('.term-chip');

  // Web Audio Synth for Cyber Sound Effects (No external files)
  function playCyberBeep(freq = 600, duration = 0.05) {
    try {
      const AudioContext = window.AudioContext || (window as any).webkitAudioContext;
      if (!AudioContext) return;
      const ctx = new AudioContext();
      const osc = ctx.createOscillator();
      const gain = ctx.createGain();
      osc.type = 'sine';
      osc.frequency.setValueAtTime(freq, ctx.currentTime);
      gain.gain.setValueAtTime(0.04, ctx.currentTime);
      gain.gain.exponentialRampToValueAtTime(0.0001, ctx.currentTime + duration);
      osc.connect(gain);
      gain.connect(ctx.destination);
      osc.start();
      osc.stop(ctx.currentTime + duration);
    } catch (e) {
      // Audio autoplay policy fallback
    }
  }

  function toggleTerminal() {
    modal?.classList.toggle('hidden');
    if (!modal?.classList.contains('hidden')) {
      playCyberBeep(750, 0.08);
      setTimeout(() => input?.focus(), 100);
    }
  }

  floatingBtn?.addEventListener('click', toggleTerminal);
  closeBtn?.addEventListener('click', toggleTerminal);
  window.addEventListener('toggle-edwin-terminal', toggleTerminal);

  modal?.addEventListener('click', (e) => {
    if (e.target === modal) toggleTerminal();
  });

  clearBtn?.addEventListener('click', () => {
    if (historyEl) historyEl.innerHTML = '';
  });

  function executeCommand(rawCmd: string) {
    let cmd = rawCmd.trim().toLowerCase();
    if (!cmd) return;

    // Normalizar acentos y caracteres especiales
    const normalized = cmd.normalize('NFD').replace(/[\u0300-\u036f]/g, '');

    // Mapeo inteligente de sinónimos y atajos
    const aliases: Record<string, string> = {
      'chiste': 'joke',
      'broma': 'joke',
      'bromas': 'joke',
      'jokes': 'joke',
      'cafe': 'coffee',
      'cafes': 'coffee',
      'danza': 'dance',
      'danzas': 'dance',
      'clean-core': 'cleancore',
      'clean_core': 'cleancore',
      'clean': 'cleancore',
      'core': 'cleancore',
      'certificaciones': 'certs',
      'certificados': 'certs',
      'cert': 'certs',
      'experiencia': 'experience',
      'proyectos': 'projects',
      'proyecto': 'projects',
      'contacto': 'contact',
      'contratar': 'hire',
      'salario': 'salary',
      'sueldo': 'salary',
      'tarifa': 'salary',
      'ayuda': 'help',
      'cls': 'clear'
    };

    const targetKey = aliases[cmd] || aliases[normalized] || cmd;

    playCyberBeep(900, 0.04);

    const userLine = document.createElement('div');
    userLine.className = 'text-cyan-300 flex items-center gap-2 pt-2 border-t border-white/5';
    userLine.innerHTML = `<span class="text-emerald-400 font-bold">>_</span> <span class="font-bold">${cmd}</span>`;
    historyEl?.appendChild(userLine);

    if (targetKey === 'clear') {
      if (historyEl) historyEl.innerHTML = '';
      if (input) input.value = '';
      return;
    }

    const respDiv = document.createElement('div');
    respDiv.className = 'text-slate-200 whitespace-pre-wrap pl-4 border-l-2 border-cyan-500/30 font-mono py-1 leading-relaxed';

    if (terminalCommands[targetKey]) {
      const response = terminalCommands[targetKey];
      respDiv.textContent = typeof response === 'string' ? response : response.output;
    } else {
      respDiv.innerHTML = `<span class="text-rose-400 font-semibold">Comando no reconocido: '${cmd}'.</span>\nEscribe <strong class="text-cyan-300">'help'</strong> para explorar los módulos disponibles o utiliza los botones de acceso rápido.`;
    }

    historyEl?.appendChild(respDiv);
    if (input) input.value = '';

    // Scroll to bottom
    if (screen) {
      screen.scrollTop = screen.scrollHeight;
    }
  }

  input?.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') {
      executeCommand(input.value);
    }
  });

  submitBtn?.addEventListener('click', () => {
    if (input) executeCommand(input.value);
  });

  chips.forEach(chip => {
    chip.addEventListener('click', () => {
      const cmd = chip.getAttribute('data-cmd');
      if (cmd) executeCommand(cmd);
    });
  });
</script>
