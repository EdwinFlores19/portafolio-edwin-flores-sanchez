---
// TechStackMatrix.astro - High-Tech Skills & Capabilities Radar Grid
import { skillCategories } from '../data/skills';
---

<section id="skills" class="py-20 px-4 sm:px-6 lg:px-8 relative z-10">
  <div class="max-w-7xl mx-auto space-y-12">
    
    <!-- Section Header -->
    <div class="text-center space-y-4 max-w-3xl mx-auto">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full glass-panel border border-cyan-500/40 text-cyan-300 text-xs font-mono tracking-widest uppercase shadow-neon-cyan/20">
        <span class="w-2 h-2 rounded-full bg-purple-400 animate-pulse"></span>
        <span>Caja de Herramientas Técnicas</span>
      </div>
      <h2 class="text-3xl sm:text-4xl md:text-5xl font-black font-display text-white tracking-tight">
        Matriz de <span class="text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 via-purple-300 to-amber-400">Dominio Técnico</span>
      </h2>
      <p class="text-xs sm:text-sm text-slate-300/80 leading-relaxed font-normal">
        Equilibrio de alto calibre entre la profundidad funcional del ecosistema ERP de SAP y el desarrollo avanzado de software, automatización e IA generativa.
      </p>
    </div>

    <!-- Categories Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
      {skillCategories.map(cat => (
        <div class="glass-panel rounded-3xl p-6 sm:p-8 border border-white/10 hover:border-cyan-500/30 transition-all duration-300 space-y-6">
          
          <div class="border-b border-white/10 pb-4">
            <h3 class="text-lg sm:text-xl font-black text-white font-display flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-cyan-400"></span>
              {cat.title}
            </h3>
            <p class="text-xs text-slate-400 font-mono mt-1">{cat.subtitle}</p>
          </div>

          <!-- Skills List with Interactive Progress Meters -->
          <div class="space-y-4">
            {cat.skills.map(s => (
              <div class="space-y-1.5 group">
                <div class="flex items-center justify-between text-xs font-mono">
                  <div class="flex items-center gap-2">
                    <span class="text-slate-200 group-hover:text-cyan-300 transition-colors font-medium">
                      {s.name}
                    </span>
                    {s.tag && (
                      <span class="text-[9px] px-2 py-0.5 rounded-md bg-cyan-950 text-cyan-300 border border-cyan-800/40">
                        {s.tag}
                      </span>
                    )}
                  </div>
                  <span class="text-slate-400 group-hover:text-cyan-400 transition-colors font-bold">
                    {s.level}%
                  </span>
                </div>

                <!-- Custom Progress Bar -->
                <div class="h-2 w-full rounded-full bg-slate-900 border border-white/5 overflow-hidden p-[1px]">
                  <div
                    class="h-full rounded-full bg-gradient-to-r from-cyan-500 to-purple-500 transition-all duration-1000 group-hover:from-cyan-400 group-hover:to-pink-500"
                    style={`width: ${s.level}%;`}
                  ></div>
                </div>
              </div>
            ))}
          </div>

        </div>
      ))}
    </div>

  </div>
</section>
